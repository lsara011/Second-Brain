DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace_with_a_long_random_development_key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
OPENAI_API_KEY=your_private_openai_api_key

# Required when DJANGO_DEBUG=false and the application sends email.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_USE_TLS=true
